<Window x:Class="BingoCaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bingo Caller" Height="900" Width="1200" Background="#2a2a2a" Foreground="White"
        WindowStartupLocation="CenterScreen" Icon="data:image/x-icon;base64,"/>
        <StackPanel Orientation="Horizontal" Margin="15">
            <Label Content="Game Type:" VerticalAlignment="Center" FontSize="14"/>
            <RadioButton Name="Ball75Radio" Content="75 Ball" IsChecked="True" VerticalAlignment="Center" Margin="5,0" GroupName="GameType"/>
            <RadioButton Name="Ball90Radio" Content="90 Ball" VerticalAlignment="Center" Margin="5,0" GroupName="GameType"/>
            <Separator Width="1" Background="#444" Margin="20,0"/>
            <Label Content="Mode:" VerticalAlignment="Center" FontSize="14" Margin="10,0"/>
            <RadioButton Name="ManualModeRadio" Content="Manual" IsChecked="True" VerticalAlignment="Center" Margin="5,0" GroupName="GameMode"/>
            <RadioButton Name="AutoModeRadio" Content="Auto" VerticalAlignment="Center" Margin="5,0" GroupName="GameMode"/>
            <Label Content="Delay (ms):" VerticalAlignment="Center" Margin="15,0,5,0"/>
            <TextBox Name="DelayTextBox" Width="80" Height="30" Text="2000" VerticalContentAlignment="Center" Margin="5,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="15" Height="50">
            <Button Name="StartButton" Content="Start Game" Width="100" Click="StartGameClick" Background="#4CAF50" Foreground="White" FontSize="12"/>
            <Button Name="CallNumberButton" Content="Call Number" Width="100" Margin="10,0" Click="CallNumberClick" Background="#2196F3" Foreground="White" FontSize="12" IsEnabled="False"/>
            <Button Name="PauseButton" Content="Pause" Width="100" Margin="10,0" Click="PauseClick" Background="#FF9800" Foreground="White" FontSize="12" IsEnabled="False"/>
            <Button Name="ResetButton" Content="Reset" Width="100" Margin="10,0" Click="ResetClick" Background="#f44336" Foreground="White" FontSize="12"/>
            <Label Content="Status:" VerticalAlignment="Center" Margin="20,0,5,0" FontSize="12"/>
            <TextBlock Name="StatusText" VerticalAlignment="Center" Text="Ready" Foreground="#4CAF50" FontSize="12"/>
        </StackPanel>

        <TextBlock Name="LastNumberText" Margin="15,0,15,10" FontSize="18" Foreground="#2196F3" FontWeight="Bold">
            Last Called: ---
        </TextBlock>

        <ScrollViewer Margin="15" Background="#1a1a1a" CornerRadius="5">
            <Grid Name="NumberGrid" Background="Transparent"/>
        </ScrollViewer>

        <StackPanel Margin="15,10" Orientation="Vertical">
            <Label Content="Last 5 Numbers:" FontSize="12" Foreground="#999"/>
            <TextBlock Name="LastFiveText" FontSize="14" Foreground="#2196F3" Text="---"/>
        </StackPanel>
    </DockPanel>
</Window>
